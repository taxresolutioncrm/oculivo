{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oculivo",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.oculivo.com",
      "custom_domain": true
    }
  ]
}
